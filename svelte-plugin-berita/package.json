{
	"name": "svelte-plugin-berita",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.28.0",
		"@tiptap/core": "^3.29.2",
		"@tiptap/extension-bubble-menu": "^3.29.2",
		"@tiptap/extension-code-block-lowlight": "^3.29.2",
		"@tiptap/extension-collaboration": "^3.29.2",
		"@tiptap/extension-drag-handle": "^3.29.2",
		"@tiptap/extension-highlight": "^3.29.2",
		"@tiptap/extension-image": "^3.29.2",
		"@tiptap/extension-list": "^3.29.2",
		"@tiptap/extension-mathematics": "^3.29.2",
		"@tiptap/extension-node-range": "^3.29.2",
		"@tiptap/extension-subscript": "^3.29.2",
		"@tiptap/extension-superscript": "^3.29.2",
		"@tiptap/extension-table": "^3.29.2",
		"@tiptap/extension-table-of-contents": "^3.29.2",
		"@tiptap/extension-text-align": "^3.29.2",
		"@tiptap/extension-text-style": "^3.29.2",
		"@tiptap/extension-typography": "^3.29.2",
		"@tiptap/extension-unique-id": "^3.29.2",
		"@tiptap/extensions": "^3.29.2",
		"@tiptap/markdown": "^3.29.2",
		"@tiptap/pm": "^3.29.2",
		"@tiptap/starter-kit": "^3.29.2",
		"@tiptap/suggestion": "^3.29.2",
		"@tiptap/y-tiptap": "^3.0.8",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"katex": "^0.17.0",
		"lowlight": "^3.3.0",
		"mermaid": "^11.16.0",
		"mode-watcher": "^1.1.0",
		"svelte-lexical": "^0.6.5",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.31"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"keywords": [
		"svelte"
	]
}
